<p class="mt-10 font-medium"><%= place_status_message(result) %></p>
<% if result.province %>
  <p class="text-sm text-gray-500">Limited to <%= result.province.delete_prefix("CA-") %>, as named in the search.</p>
<% end %>

<% if result.candidates.any? %>
  <ol class="mt-4 space-y-3">
    <%= render partial: "candidate", collection: result.candidates, locals: { best: result.candidates.first } %>
  </ol>
<% end %>

<% if result.suggestions.any? %>
  <h2 class="mt-8 text-sm font-semibold uppercase tracking-wide text-gray-500">Other similar names</h2>
  <ol class="mt-2 space-y-3">
    <%= render partial: "candidate", collection: result.suggestions, locals: { best: nil } %>
  </ol>
<% end %>
