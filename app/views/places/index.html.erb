<% content_for :title, "Place search — Flyway" %>

<h1 class="text-3xl font-semibold tracking-tight">Place search</h1>
<p class="mt-2 text-gray-600">
  How a place name is understood: provinces, regions, cities, eBird counties and hotspots, and well-known birding sites
  in Quebec, Ontario and the Maritimes.
</p>

<%= form_with url: places_path, method: :get, data: { turbo_frame: "results", turbo_action: "advance" }, class: "mt-6 flex items-center gap-2 rounded-2xl border border-gray-300 py-1.5 pl-4 pr-1.5 shadow-sm transition focus-within:border-blue-700 focus-within:ring-2 focus-within:ring-blue-700/20" do |form| %>
  <%= form.search_field :q, value: @query, placeholder: "Tadoussac, southern Quebec, Kingston NS…", autofocus: true,
        aria: { label: "Place name" }, class: "min-w-0 flex-1 bg-transparent py-1.5 outline-none placeholder:text-gray-400" %>
  <%= form.submit "Search", name: nil, class: "rounded-xl bg-blue-700 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-800" %>
<% end %>

<div class="mt-3 flex flex-wrap items-center gap-1.5 text-sm">
  <span class="mr-1 text-gray-500">Try</span>
  <% [ "Tadoussac", "Quebec", "Kingston", "the Montreal area", "cap tourmante", "Gaspésie" ].each do |example| %>
    <%= link_to example, places_path(q: example), data: { turbo_frame: "results", turbo_action: "advance" }, class: "chip" %>
  <% end %>
</div>

<%= turbo_frame_tag "results" do %>
  <% if @result %>
    <%= render "results", result: @result %>
  <% end %>
<% end %>
