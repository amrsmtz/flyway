<header class="flex flex-wrap items-center gap-x-6 gap-y-2 border-b border-gray-200 px-4 py-2.5">
  <%= link_to root_path, class: "flex min-w-0 items-center gap-2.5" do %>
    <span class="grid size-7 shrink-0 place-items-center rounded-lg bg-blue-700 text-white" aria-hidden="true">
      <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8.5c2-2.5 4-3 6-1 2-2 4-1.5 6 1"/></svg>
    </span>
    <span class="text-lg font-semibold tracking-tight">Flyway</span>
    <span class="hidden truncate text-sm text-gray-500 sm:inline">Did the weather move the birds? Bird migration and wind in eastern Canada.</span>
  <% end %>
  <nav class="ml-auto flex flex-wrap items-center gap-1 text-sm">
    <%= link_to status_path, class: "mr-1 flex items-center gap-3 rounded-full border border-gray-200 px-3 py-1 text-gray-700 transition-colors hover:bg-gray-50" do %>
      <% feed_statuses.each do |status| %>
        <span class="flex items-center gap-1.5" title="<%= status.name %>: last collected <%= time_ago_or_never(status.last_success_at) %>">
          <span class="inline-block size-2 rounded-full <%= feed_health_dot(status) %>"></span><%= status.name %>
        </span>
      <% end %>
    <% end %>
    <%= link_to "Data status", status_path, class: "nav-link", aria: { current: ("page" if current_page?(status_path)) } %>
    <%= link_to "Places", places_path, class: "nav-link", aria: { current: ("page" if current_page?(places_path)) } %>
  </nav>
</header>
