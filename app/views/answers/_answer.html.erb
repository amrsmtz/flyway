<%= turbo_frame_tag "answer" do %>
  <article class="mt-4 text-sm">
    <p class="font-medium text-gray-900"><%= answer.question %></p>

    <% if answer.status == "failed" %>
      <p class="mt-2 rounded bg-amber-50 p-3 text-amber-900">
        The language model could not be reached just now, so this question was not answered. The map, the timeline and
        the suggested questions still work; please try again in a minute.
      </p>
    <% else %>
      <p class="mt-2 text-base leading-relaxed text-gray-900"><%= answer.text %></p>

      <% if answer.key_figures.any? %>
        <h3 class="mt-4 text-xs font-semibold uppercase tracking-wide text-gray-500">Key figures</h3>
        <ul class="mt-1 space-y-1">
          <% answer.key_figures.each do |figure| %>
            <li>
              <%= figure["text"] %>
              <% figure["evidence"].to_a.each do |key| %>
                <%= link_to "[#{key}]", answer_evidence_path(answer, key), target: "_blank", rel: "noopener",
                      class: "text-blue-700 underline", title: answer.evidence_set(key)&.dig("title") %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <%= confidence_badge(answer) %>
        <% if (view = answer_map_view(answer)) %>
          <button type="button" class="explorer-choice" data-action="explorer#showAnswer"
                  data-bounds="<%= view[:bounds].to_json %>" data-date="<%= view[:date] %>" data-group="<%= view[:group] %>">Show on map</button>
        <% end %>
      </div>
      <ul class="mt-1 list-disc space-y-0.5 pl-5 text-gray-700">
        <% answer.confidence_reasons.each do |reason| %><li><%= reason %></li><% end %>
      </ul>

      <% if answer.caveats.any? %>
        <h3 class="mt-4 text-xs font-semibold uppercase tracking-wide text-gray-500">Keep in mind</h3>
        <ul class="mt-1 list-disc space-y-0.5 pl-5 text-gray-700">
          <% answer.caveats.each do |caveat| %><li><%= caveat %></li><% end %>
        </ul>
      <% end %>

      <% if answer.evidence.any? %>
        <h3 class="mt-4 text-xs font-semibold uppercase tracking-wide text-gray-500">Sources</h3>
        <ul class="mt-1 space-y-0.5">
          <% answer.evidence.each do |set| %>
            <li>
              <%= link_to "[#{set["key"]}]", answer_evidence_path(answer, set["key"]), target: "_blank", rel: "noopener", class: "text-blue-700 underline" %>
              <%= set["title"] %> <span class="text-gray-500">· <%= set["source"] %></span>
            </li>
          <% end %>
        </ul>
      <% end %>

      <p class="mt-4 text-xs text-gray-500">
        Data freshness: <%= freshness_sentence(answer).presence || "no feed was used" %>.
        Answer written <%= time_ago_in_words(answer.created_at || Time.current) %> ago<%= " by #{answer.model}" if answer.model %>.
        <%= link_to "Link to this answer", answer_path(answer), target: "_blank", rel: "noopener", class: "underline" if answer.persisted? %>
      </p>
    <% end %>
  </article>
<% end %>
